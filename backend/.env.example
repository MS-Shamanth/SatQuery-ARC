# SatQuery ARC - backend configuration
# Copy to .env and fill in. NEVER commit .env.

# --- Language model provider (Analysis Contract drafting + narration only) ---
# Which provider drafts contracts and phrases explanations. Accepts a
# comma-separated list, tried in order:
#   mistral     own daily allowance
#   openrouter  own daily allowance
#   gemini      kept working, not in the default chain
#   none        no model at all; the offline rule router and the deterministic
#               reasoning do the whole job. Everything still works.
#
# A list of providers, not a list of models, is what survives a quota. Free tiers
# meter per account per day, so several free models from one vendor share a single
# allowance and expire together. A second vendor is a second allowance.
#
# A name whose key is missing is dropped from the chain rather than substituted,
# and the drop is reported in /api/health.
#
# Whatever this is set to, no provider ever measures anything. They read the
# question and plan, or they phrase a finished ledger. Every number comes from the
# deterministic tools.
LLM_PROVIDER=mistral,openrouter

# --- Mistral ---
# Get a key from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# open-mistral-nemo is small and answers quickly. mistral-small-latest is stronger
# but is rate limited harder on the free tier, so it sits second.
MISTRAL_MODEL=open-mistral-nemo
MISTRAL_MODEL_FALLBACKS=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- OpenRouter ---
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Tried in order when the primary returns a transient 429 or 5xx.
OPENROUTER_MODEL_FALLBACKS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer and X-Title so usage is attributable in the OpenRouter
# dashboard. Neither is required and neither carries anything secret.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SatQuery ARC

# --- Gemini (available, not the default) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Note: the gemini-2.5-* family is closed to newly issued keys and returns 404.
GEMINI_MODEL=gemini-3.7-flash
# Tried in order when the primary returns a transient 503 or 429.
GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# --- Copernicus Data Space Ecosystem (real Sentinel-1 SAR) ---
# Free registration: https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=

# --- AWS (optional: Earth Search sentinel-1-grd is requester-pays) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# --- Runtime ---
SATQUERY_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Force the offline rule-based contract router even when a provider is configured
FORCE_OFFLINE_CONTRACT=false
# How long to wait on a provider before falling back to the rule router. A model
# that hangs must not hang the request: the offline path is always available.
#
# This is wall-clock, not silence. A queued free model holds the connection open
# and dribbles keep-alive bytes, which resets an ordinary socket timeout forever;
# one request sat for over three minutes under a 25 second setting before this was
# measured against a deadline instead. A whole chain is capped at twice this.
LLM_TIMEOUT_SECONDS=30
